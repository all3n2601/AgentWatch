# Frozen TFDV schema for steps-v1.2. Generated by
#   python -m agentwatch_validation freeze-schema
# from a release and its column contract. Change it only in a reviewed PR.
feature {
  name: "run_id"
  type: BYTES
  presence {
    min_fraction: 1.0
    min_count: 1
  }
  shape {
    dim {
      size: 1
    }
  }
}
feature {
  name: "step_id"
  type: BYTES
  presence {
    min_fraction: 1.0
    min_count: 1
  }
