{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentWatch concurrency policy API",
    "description": "Versioned manual concurrency policy with append-only audit history.",
    "version": "live-contracts-v1"
  },
  "paths": {
    "/v1/policies/concurrency/{target}": {
      "get": {
        "tags": [
          "concurrency policy"
        ],
        "summary": "Get Active Policy",
        "operationId": "get_active_policy_v1_policies_concurrency__target__get",
        "parameters": [
          {
            "name": "target",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Target"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyVersion"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request, limits or restore source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal storage failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or statement/lock timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unsupported policy target",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/policies/concurrency/{target}/versions": {
      "get": {
        "tags": [
          "concurrency policy"
        ],
        "summary": "List Policy Versions",
        "operationId": "list_policy_versions_v1_policies_concurrency__target__versions_get",
        "parameters": [
          {
            "name": "target",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Target"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 9223372036854775807,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyPage"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request, limits or restore source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal storage failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or statement/lock timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unsupported policy target",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "concurrency policy"
        ],
        "summary": "Change Policy",
        "operationId": "change_policy_v1_policies_concurrency__target__versions_post",
        "parameters": [
          {
            "name": "target",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Target"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyChange"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyChangeResult"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request, limits or restore source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal storage failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or statement/lock timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unparseable body or invalid Content-Length",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "Policy body upload exceeds 10 seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Stale expected_version or request_id reused with a different change",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Policy body exceeds 1048576 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unsupported policy target",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyChangeResult"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ControlledService": {
        "properties": {
          "service_id": {
            "type": "string",
            "title": "Service Id"
          },
          "resource_class": {
            "type": "string",
            "enum": [
              "cpu_sandbox",
              "inference",
              "retrieval"
            ],
            "title": "Resource Class"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "service_id",
          "resource_class"
        ],
        "title": "ControlledService"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "PolicyChange": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "action": {
            "type": "string",
            "enum": [
              "set",
              "disable",
              "restore"
            ],
            "title": "Action"
          },
          "limits": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolicyLimits"
              },
              {
                "type": "null"
              }
            ]
          },
          "restored_from": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Restored From"
          },
          "operator": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Operator"
          },
          "reason": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_version",
          "action",
          "operator",
          "reason"
        ],
        "title": "PolicyChange"
      },
      "PolicyChangeResult": {
        "properties": {
          "created": {
            "type": "boolean",
            "title": "Created"
          },
          "policy": {
            "$ref": "#/components/schemas/PolicyVersion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "created",
          "policy"
        ],
        "title": "PolicyChangeResult"
      },
      "PolicyLimits": {
        "properties": {
          "inference_requests": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1024.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Inference Requests"
          },
          "test_jobs": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1024.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Jobs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PolicyLimits",
        "description": "Per-control limits; an omitted control means no limit."
      },
      "PolicyPage": {
        "properties": {
          "versions": {
            "items": {
              "$ref": "#/components/schemas/PolicyVersion"
            },
            "type": "array",
            "title": "Versions"
          },
          "next_before": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Before"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "versions",
          "next_before"
        ],
        "title": "PolicyPage"
      },
      "PolicyVersion": {
        "properties": {
          "target": {
            "type": "string",
            "title": "Target"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "action": {
            "type": "string",
            "enum": [
              "baseline",
              "set",
              "disable",
              "restore"
            ],
            "title": "Action"
          },
          "limits": {
            "$ref": "#/components/schemas/PolicyLimits"
          },
          "restored_from": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restored From"
          },
          "operator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operator"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "controlled_services": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ControlledService"
            },
            "type": "object",
            "title": "Controlled Services"
          },
          "enforcement_scope": {
            "type": "string",
            "const": "runner_process",
            "title": "Enforcement Scope"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target",
          "version",
          "action",
          "limits",
          "restored_from",
          "operator",
          "reason",
          "request_id",
          "created_at",
          "controlled_services",
          "enforcement_scope"
        ],
        "title": "PolicyVersion"
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue"
      }
    }
  }
}
