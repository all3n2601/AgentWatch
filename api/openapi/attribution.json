{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentWatch live attribution API",
    "description": "UUID-specific polling of stored step attributions and the serving model's status. See docs/live-ingestion.md (Attribution) for cursor, state and wording rules.",
    "version": "live-contracts-v1"
  },
  "paths": {
    "/v1/live/runs/{run_id}/attributions": {
      "get": {
        "tags": [
          "live attribution"
        ],
        "summary": "Get Attributions",
        "description": "Stored step attributions of the selected run after the `after` cursor, oldest first, with the serving model's status. Terminal steps lacking a row for the current serving key are attributed before the page is read. A run without terminal steps returns an empty page. A record attributes the resource a step likely waited on; it does not establish a cause. See docs/live-ingestion.md (Attribution).",
        "operationId": "get_attributions_v1_live_runs__run_id__attributions_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 9223372036854775807,
              "minimum": 0,
              "default": 0,
              "title": "After"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 256,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttributionPage"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or semantic validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal storage failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or statement/lock timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Selected live run does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/live/attribution/model": {
      "get": {
        "tags": [
          "live attribution"
        ],
        "summary": "Get Model Status",
        "description": "The serving model's state, reason and identity, as every attribution page reports it. A record attributes the resource a step likely waited on; it does not establish a cause. See docs/live-ingestion.md (Attribution).",
        "operationId": "get_model_status_v1_live_attribution_model_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelStatusView"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request or semantic validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal storage failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or statement/lock timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttributionItem": {
        "properties": {
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "serving_key": {
            "type": "string",
            "title": "Serving Key"
          },
          "committed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Committed At"
          },
          "step_terminal_received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Step Terminal Received At"
          },
          "evidence_changed": {
            "type": "boolean",
            "title": "Evidence Changed"
          },
          "record": {
            "additionalProperties": true,
            "type": "object",
            "title": "Record"
          }
        },
        "type": "object",
        "required": [
          "sequence",
          "serving_key",
          "committed_at",
          "step_terminal_received_at",
          "evidence_changed",
          "record"
        ],
        "title": "AttributionItem",
        "description": "One stored step attribution. `record` is the attribution record: feature row, missing\ninputs, telemetry status, rules verdict and model outcome. Both times are database-clock\ntimes; `evidence_changed` is set when a later audit computed a different feature row."
      },
      "AttributionPage": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "model": {
            "$ref": "#/components/schemas/ModelStatusView"
          },
          "attributions": {
            "items": {
              "$ref": "#/components/schemas/AttributionItem"
            },
            "type": "array",
            "title": "Attributions"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "model",
          "attributions",
          "next_cursor"
        ],
        "title": "AttributionPage",
        "description": "Stored attributions of the selected run after the `after` cursor, oldest first. Rows of\nevery serving key are returned; the current one is `model.serving_key`."
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "ModelIdentityView": {
        "properties": {
          "training_version": {
            "type": "string",
            "title": "Training Version"
          },
          "calibration_version": {
            "type": "string",
            "title": "Calibration Version"
          },
          "classifier_sha256": {
            "type": "string",
            "title": "Classifier Sha256"
          },
          "regressor_sha256": {
            "type": "string",
            "title": "Regressor Sha256"
          },
          "preprocessing_sha256": {
            "type": "string",
            "title": "Preprocessing Sha256"
          },
          "calibration_sha256": {
            "type": "string",
            "title": "Calibration Sha256"
          },
          "temperature": {
            "type": "number",
            "title": "Temperature"
          },
          "abstention_threshold": {
            "type": "number",
            "title": "Abstention Threshold"
          },
          "class_order": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Class Order"
          },
          "blocks_promotion": {
            "type": "boolean",
            "title": "Blocks Promotion"
          }
        },
        "type": "object",
        "required": [
          "training_version",
          "calibration_version",
          "classifier_sha256",
          "regressor_sha256",
          "preprocessing_sha256",
          "calibration_sha256",
          "temperature",
          "abstention_threshold",
          "class_order",
          "blocks_promotion"
        ],
        "title": "ModelIdentityView",
        "description": "What was loaded: versions, artifact hashes and calibration parameters."
      },
      "ModelStatusView": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "not_configured",
              "not_promoted_refused",
              "ready_not_promoted",
              "ready_promoted",
              "load_failed"
            ],
            "title": "State"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "identity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelIdentityView"
              },
              {
                "type": "null"
              }
            ]
          },
          "not_promoted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Not Promoted"
          },
          "serving_key": {
            "type": "string",
            "title": "Serving Key"
          }
        },
        "type": "object",
        "required": [
          "state",
          "reason",
          "identity",
          "not_promoted",
          "serving_key"
        ],
        "title": "ModelStatusView",
        "description": "The serving model's status. `identity` is set whenever a pair was loaded, refused ones\nincluded; `not_promoted` is None when none was. `serving_key` identifies the rules version\nand model configuration that rows written now carry."
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue"
      }
    }
  }
}
