            "title": "Resource Class"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resource_id",
          "service_id",
          "resource_class"
        ],
        "title": "ResourceRegistration"
      },
      "ResourceSample": {
        "properties": {
          "contract_version": {
