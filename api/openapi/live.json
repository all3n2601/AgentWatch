          },
          "metric": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Metric"
          },
          "unit": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Unit"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "availability": {
            "type": "string",
            "enum": [
              "measured",
              "missing",
              "unsupported",
              "malformed",
              "unavailable"
            ],
            "title": "Availability"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512,
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
