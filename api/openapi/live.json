          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "task_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Task Id"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "clock_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Clock Id"
          },
          "record_type": {
            "type": "string",
            "const": "resource_sample",
            "title": "Record Type"
          },
          "sample_id": {
            "type": "string",
            "format": "uuid",
            "title": "Sample Id"
          },
          "resource_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Resource Id"
          },
          "service_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Service Id"
          },
          "resource_class": {
            "type": "string",
            "enum": [
              "cpu_sandbox",
              "inference",
              "retrieval"
            ],
            "title": "Resource Class"
          },
          "tick_ns": {
            "type": "integer",
