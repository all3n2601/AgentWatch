          "run_id",
          "task_id",
          "observed_at",
          "clock_id",
          "record_type",
          "sample_id",
          "resource_id",
          "service_id",
          "resource_class",
          "tick_ns",
          "metric",
          "unit",
          "value",
          "availability",
          "reason"
        ],
        "title": "ResourceSample"
      },
