{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentWatch live ingestion API",
    "description": "Bounded incremental ingestion and UUID-specific polling. See docs/live-ingestion.md for lifecycle, retry, gap and cleanup semantics.",
    "version": "live-contracts-v1"
  },
  "paths": {
    "/v1/live/runs": {
      "post": {
        "tags": [
          "live lifecycle"
        ],
        "summary": "Create Run",
        "operationId": "create_run_v1_live_runs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResult"
                }
              }
            }
          },
          "404": {
            "description": "Selected live run does not exist"
          },
          "409": {
            "description": "Identity, revision or lifecycle conflict; batch rolled back"
          },
          "413": {
            "description": "Live body exceeds 1 MiB"
          },
          "408": {
            "description": "Live body upload exceeds 10 seconds"
          },
          "503": {
            "description": "Database unavailable or statement/lock timeout"
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResult"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "live lifecycle"
        ],
        "summary": "List Runs",
        "operationId": "list_runs_v1_live_runs_get",
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPage"
                }
              }
            }
          },
          "404": {
            "description": "Selected live run does not exist"
          },
          "409": {
            "description": "Identity, revision or lifecycle conflict; batch rolled back"
          },
          "413": {
            "description": "Live body exceeds 1 MiB"
          },
          "408": {
            "description": "Live body upload exceeds 10 seconds"
          },
          "503": {
            "description": "Database unavailable or statement/lock timeout"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/live/runs/{run_id}": {
      "get": {
        "tags": [
          "live lifecycle"
        ],
        "summary": "Get Run",
        "operationId": "get_run_v1_live_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "After"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 256,
              "minimum": 1,
              "default": 256,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSnapshot"
                }
              }
            }
          },
          "404": {
            "description": "Selected live run does not exist"
          },
          "409": {
            "description": "Identity, revision or lifecycle conflict; batch rolled back"
          },
          "413": {
            "description": "Live body exceeds 1 MiB"
          },
          "408": {
            "description": "Live body upload exceeds 10 seconds"
          },
          "503": {
            "description": "Database unavailable or statement/lock timeout"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/live/runs/{run_id}/records": {
      "post": {
        "tags": [
          "live lifecycle"
        ],
        "summary": "Ingest Records",
        "operationId": "ingest_records_v1_live_runs__run_id__records_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LiveBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          },
          "404": {
            "description": "Selected live run does not exist"
          },
          "409": {
            "description": "Identity, revision or lifecycle conflict; batch rolled back"
          },
          "413": {
            "description": "Live body exceeds 1 MiB"
          },
          "408": {
            "description": "Live body upload exceeds 10 seconds"
          },
          "503": {
            "description": "Database unavailable or statement/lock timeout"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/live/runs/{run_id}/state": {
      "post": {
        "tags": [
          "live lifecycle"
        ],
        "summary": "Change Run",
        "operationId": "change_run_v1_live_runs__run_id__state_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunChange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeResult"
                }
              }
            }
          },
          "404": {
            "description": "Selected live run does not exist"
          },
          "409": {
            "description": "Identity, revision or lifecycle conflict; batch rolled back"
          },
          "413": {
            "description": "Live body exceeds 1 MiB"
          },
          "408": {
            "description": "Live body upload exceeds 10 seconds"
          },
          "503": {
            "description": "Database unavailable or statement/lock timeout"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchResult": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "added": {
            "type": "integer",
            "title": "Added"
          },
          "acknowledgements": {
            "items": {
              "$ref": "#/components/schemas/RecordAcknowledgement"
            },
            "type": "array",
            "title": "Acknowledgements"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/Gap"
            },
            "type": "array",
            "title": "Gaps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "added",
          "acknowledgements",
          "gaps"
        ],
        "title": "BatchResult"
      },
      "ChangeResult": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "changed": {
            "type": "boolean",
            "title": "Changed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "revision",
          "changed"
        ],
        "title": "ChangeResult"
      },
      "CreateResult": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
