          },
          "service_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Service Id"
          },
          "resource_class": {
            "type": "string",
            "enum": [
              "cpu_sandbox",
              "inference",
              "retrieval"
