          },
          "missing_sequence": {
            "type": "integer",
            "title": "Missing Sequence"
          },
          "first_pending_sequence": {
            "type": "integer",
            "title": "First Pending Sequence"
          },
          "expired": {
            "type": "boolean",
            "title": "Expired"
          }
        },
        "additionalProperties": false,
