        "required": [
          "step_id",
          "missing_sequence",
          "first_pending_sequence",
          "expired"
        ],
        "title": "Gap"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LiveBatch": {
        "properties": {
          "records": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/StepEvent"
                },
                {
                  "$ref": "#/components/schemas/ResourceSample"
                }
              ],
              "discriminator": {
                "propertyName": "record_type",
                "mapping": {
                  "resource_sample": "#/components/schemas/ResourceSample",
                  "step_event": "#/components/schemas/StepEvent"
                }
              }
            },
            "type": "array",
            "maxItems": 256,
            "minItems": 1,
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records"
        ],
        "title": "LiveBatch"
      },
      "RecordAcknowledgement": {
        "properties": {
          "record_id": {
            "type": "string",
            "format": "uuid",
            "title": "Record Id"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "pending",
              "applied",
              "expired"
            ],
            "title": "Disposition"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "record_id",
          "disposition"
        ],
        "title": "RecordAcknowledgement"
      },
      "ResourceRegistration": {
        "properties": {
          "resource_id": {
            "type": "string",
