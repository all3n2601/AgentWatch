POSTGRES_DB=agentwatch
POSTGRES_USER=agentwatch
POSTGRES_PASSWORD=agentwatch_dev
DATABASE_URL=postgres://agentwatch:agentwatch_dev@localhost:5432/agentwatch?sslmode=disable
CONTROL_PLANE_URL=http://localhost:8080
AGENTWATCH_API_URL=http://127.0.0.1:8090
OLLAMA_HOST_PORT=11434
OLLAMA_URL=http://127.0.0.1:11434
AGENTWATCH_LLM_MODEL=qwen3:1.7b
AGENTWATCH_LLM_GPU=0
# Optional vLLM backend (`make vllm-up`, `--model-backend vllm`); see docs/adr/0007-vllm-request-traces-and-server-metrics.md
AGENTWATCH_MODEL_BACKEND=ollama
VLLM_HOST_PORT=8000
VLLM_URL=http://127.0.0.1:8000
VLLM_MODEL=Qwen/Qwen3-1.7B@70d244cc86cc
VLLM_GPU_MEMORY_UTILIZATION=0.6
VLLM_MAX_NUM_SEQS=2
AGENTWATCH_OTEL_TRACES_DIR=../../.data/otel
AGENTWATCH_VLLM_TRACES_FILE=.data/otel/vllm-traces.jsonl
# Optional DCGM device fields (`make dcgm-up`); leave the URL empty to skip DCGM sampling
DCGM_EXPORTER_HOST_PORT=9400
AGENTWATCH_DCGM_URL=
# Optional NVML GPM file from `make gpm-exporter` on Windows (ADR 0008); empty skips GPM sampling
AGENTWATCH_GPM_FILE=
# Dataset pipeline alerts: a Slack incoming webhook (secret; leave empty to disable alerts)
AGENTWATCH_ALERT_SLACK_WEBHOOK_URL=
AGENTWATCH_ALERT_MAX_REJECTED_SHARE=0.10
