POSTGRES_DB=agentwatch
POSTGRES_USER=agentwatch
POSTGRES_PASSWORD=agentwatch_dev
DATABASE_URL=postgres://agentwatch:agentwatch_dev@localhost:5432/agentwatch?sslmode=disable
CONTROL_PLANE_URL=http://localhost:8080
AGENTWATCH_API_URL=http://127.0.0.1:8090
OLLAMA_HOST_PORT=11434
OLLAMA_URL=http://127.0.0.1:11434
AGENTWATCH_LLM_MODEL=qwen3:1.7b
AGENTWATCH_LLM_GPU=0
